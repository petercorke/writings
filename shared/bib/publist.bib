@inproceedings{Mejias06,
	abstract = {The use of UAVs in civilian and domestic applications is highly demanding, requiring a high-level of capability from the vehicles. This work addresses the task in which aUAV is performing an inspection on a set of power lines and an emergency situation occures requiring the UAV to avoid the lines and then find a safe landing area (a forced landing). This problem is approached using vision, where the vision system actsas the overall controller sending velocity commands to a low-level controller. The use of vision here allows the 2D position of the UAV to be updated by an image-based signal where the error to minimize is the location of a feature or set of features in theimage. The system has been tested in a Air Vehicle Simulator (AVS) a cable array robot which allows to simulate and control three DOF (translation) of a UAV. Results obtained from tests in a scale scenario show the feasibility of this approach.},
	address = {Beijing},
	author = {Mejias, Luis and Roberts, Jonathan and Usher, Kane and Corke, Peter and Campoy, Pascual},
	booktitle = iros,
	date-modified = {2011-07-04 22:00:35 +0100},
	institution = {ARROW Discovery Service [http://search.arrow.edu.au/apps/ArrowUI/OAIHandler] (Australia)},
	keywords = {280208 Computer Vision, 290299 Aerospace Engineering not elsewhere classified},
	location = {http://www.scientificcommons.org/23040428},
	month = oct,
	pages = {3527-3532},
	title = {Two seconds to touchdown ---Vision-based controlled forced landing},
	url = {http://eprints.qut.edu.au/archive/00008358/},
	year = {2006},
	bdsk-url-1 = {http://eprints.qut.edu.au/archive/00008358/}}

