@inproceedings{Warren12a,
	abstract = {Visual sea-floor mapping is a rapidly growing application for Autonomous Underwater Vehicles (AUVs). AUVs are well-suited to the task as they remove humans from a potentially dangerous environment, can reach depths human divers cannot, and are capable of long-term operation in adverse conditions. The output of sea-floor maps generated by AUVs has a number of applications in scientific monitoring: from classifying coral in high biological value sites to surveying sea sponges to evaluate marine environment health.},
	address = {University of Sydney, NSW},
	author = {Michael Warren and Peter Corke and Oscar Pizzaro and Stefan William and Ben Upcroft},
	booktitle = {Workshop on Robotics for Environmental Monitoring},
	date-added = {2013-02-04 02:08:04 +0000},
	date-modified = {2013-02-04 06:04:36 +0000},
	editor = {Ryan N. Smith},
	keywords = {Bundle Adjustment, Visual Odometry, Autonomous Underwater Vehicle, Environmental Monitoring, Pose Estimation},
	month = {July},
	title = {Bi-objective bundle adjustment: towards large-scale visual sea-floor mapping with a minimal sensor suite},
	url = {http://eprints.qut.edu.au/53104/},
	year = {2012},
	bdsk-url-1 = {http://eprints.qut.edu.au/53104/}}

@inproceedings{Warren12b,
	abstract = {In most visual mapping applications suited to Autonomous Underwater Vehicles (AUVs), stereo visual odometry (VO) is rarely utilised as a pose estimator as imagery is typically of very low framerate due to energy conservation and data storage requirements. This adversely affects the robustness of a vision-based pose estimator and its ability to generate a smooth trajectory. This paper presents a novel VO pipeline for low-overlap imagery from an AUV that utilises constrained motion and integrates magnetometer data in a bi-objective bundle adjustment stage to achieve low-drift pose estimates over large trajectories.

We analyse the performance of a standard stereo VO algorithm and compare the results to the modified vo algorithm. Results are demonstrated in a virtual environment in addition to low-overlap imagery gathered from an AUV. The modified VO algorithm shows significantly improved pose accuracy and performance over trajectories of more than 300m. In addition, dense 3D meshes generated from the visual odometry pipeline are presented as a qualitative output of the solution.},
	address = {Wellington, New Zealand},
	author = {Michael Warren and Peter Corke and Oscar Pizzaro and Stefan Williams and Ben Upcroft},
	booktitle = {Australasian Conference on Robotics and Automation},
	date-added = {2013-02-04 02:07:42 +0000},
	date-modified = {2013-02-04 06:05:31 +0000},
	keywords = {Visual Odometry, Bundle Adjustment, Autonomous Underwater Vehicle, Field Robotics},
	month = {November},
	title = {Visual sea-floor mapping from low overlap imagery using bi-objective bundle adjustment and constrained motion},
	url = {http://eprints.qut.edu.au/55403/},
	year = {2012},
	bdsk-url-1 = {http://eprints.qut.edu.au/55403/}}

